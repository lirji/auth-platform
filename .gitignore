.classpath
.project
.settings/
.factorypath
.vscode/

# ---- 日志 ----
*.log
logs/

# ---- 环境与密钥（deploy/.env 含预共享 Bearer key，勿提交）----
.env
deploy/.env
*.env.local

# ---- auth-console（规划中的 React 前端）----
node_modules/
auth-console/dist/
auth-console/build/
auth-console/.vite/
