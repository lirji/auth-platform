pom.xml.releaseBackup
pom.xml.next
release.properties
hs_err_pid*
replay_pid*

# Python 开通脚本本地缓存
**/__pycache__/
*.py[cod]

# 日志与本地运行临时文件
*.log.*
*.pid
*.pid.lock
*.tmp
/tmp/
/temp/

