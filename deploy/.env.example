# 复制为 .env 按需覆盖。端口默认已避开现有项目占用。
PG_USER=authz
PG_PASSWORD=CHANGE_ME
SPICEDB_KEY=CHANGE_ME

# 固定与当前环境一致的组件；SpiceDB serve 与 migrate 必须使用同一镜像。
SPICEDB_IMAGE=authzed/spicedb:v1.56.2@sha256:aa96009a0477f8a759149823407d47ad16d1a74390bae3102b3b0b7143502764
CASDOOR_IMAGE=casbin/casdoor@sha256:1b479655bf51b1c630f2a3ea93ec1ef58388e1d5861173377269266ea321537e

# 应用镜像可指定任务/发行版本标签；build 仍从当前源码构建。
AUTH_PORTAL_IMAGE=auth-platform/project-portal:local
GOVERNANCE_CONSOLE_IMAGE=auth-platform/governance-console:local
GOVERNANCE_ADMIN_IMAGE=auth-platform/governance-admin:local

# 治理专用私密 env 由 provision-local.py 生成。入口见 deploy/governance/README.md。
# GOVERNANCE_RUNTIME_DIR=/absolute/path/to/private/runtime
# GOVERNANCE_CLIENT_ID=auth-console-docker

# 端口(宿主机侧)
SPICEDB_PG_PORT=15432
SPICEDB_GRPC_PORT=50051
SPICEDB_HTTP_PORT=8543
SPICEDB_METRICS_PORT=9099
CASDOOR_PORT=8000
# 公开门户及各业务项目浏览器入口统一由 platform-ports.env 管理。

# 本机 secure 联邦推荐让两个登录组织签发同一货主 dev-tenant；这两项仅供开通脚本使用，
# 不是 Casdoor organization，也不会由 Compose 自动注入脚本。执行脚本时请显式传入：
# MARKETING_BUSINESS_TENANT=dev-tenant
# BENEFIT_BUSINESS_TENANT=dev-tenant
