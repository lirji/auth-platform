# 统一能力门户可见入口端口的唯一注册表。
#
# 修改任何项目在 http://localhost:5274 中展示/访问的端口时，只改本文件；
# deploy/platform-ports.sh sync 会同步 project-portal catalog，项目启动脚本会自动加载本文件。
# 所有值必须是 1-65535 的互不重复整数。这里只管理浏览器入口，不管理项目内部数据库/Kafka 等端口。

AUTH_PORTAL_UI_PORT=5274
LANGCHAIN4J_UI_PORT=8093
RECSYS_UI_PORT=9095
DROOLS_UI_PORT=8095
RISK_UI_PORT=15173
WORKFLOW_UI_PORT=8302
RECON_UI_PORT=8088
BENEFIT_UI_PORT=8083
MARKETING_UI_PORT=8084
